# ==============================================================================
# EuroNova — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
#  1. Copy this file to `.env.local`: `cp .env.example .env.local`
#  2. Replace all placeholder values with your real project credentials.
#  3. NEVER commit `.env.local` to Git. It is automatically ignored by `.gitignore`.
#  4. Validate your configuration at any time by running: `node scripts/validate-env.mjs`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SUPABASE DATABASE & AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard > Project Settings > API
# NEXT_PUBLIC_SUPABASE_URL: Must start with https:// and point to your Supabase project instance.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public API key with Row Level Security (RLS) enforcement. Safe for client-side bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-public-anon-jwt-token-here"

# SUPABASE_SERVICE_ROLE_KEY: High-privilege secret key that bypasses RLS. Server-side only (Server Actions & Crons).
# NEVER expose this key in client-side code or public repositories.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-super-admin-service-role-jwt-token-here"

# SUPABASE_DB_URL: Direct PostgreSQL connection URI (Port 5432) or Session Pooler URI (Port 5432).
# Required for running local migrations, db:backup cron (`pg_dump`), and CI/CD pipelines.
# Do NOT use the Transaction Pooler (Port 6543) because `pg_dump` requires PostgreSQL session state.
SUPABASE_DB_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SECURITY, LIVE OPS & CRON PIPELINES (Required for Production)
# ------------------------------------------------------------------------------
# CRON_SECRET: Cryptographic authorization token for background cron endpoints (`/api/cron/*`).
# Must be at least 16 characters long (32+ characters strongly recommended for production).
# Verified using constant-time SHA-256 cryptographic comparison (`crypto.timingSafeEqual`).
CRON_SECRET="your_cryptographic_cron_secret_minimum_32_characters_long"

# NEXT_PUBLIC_SITE_URL: Canonical base URL for production routing, OpenGraph cards, sitemap.xml, and robots.txt.
# Must include protocol (https://). Defaults to `https://euronova.vercel.app` if left unset.
NEXT_PUBLIC_SITE_URL="https://euronova.vercel.app"

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL & NOTIFICATIONS (Optional / Recommended)
# ------------------------------------------------------------------------------
# Configure SMTP credentials for transactional emails (welcome notifications, password resets, ticket updates).
# For Gmail: Use a 16-character Google App Password (NOT your regular Google account password).
# Obtain from: https://myaccount.google.com/apppasswords
EMAIL_USER="your-system-email@gmail.com"
EMAIL_PASSWORD="your-16-character-google-app-password"

# Standard SMTP configuration fallbacks:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-system-email@gmail.com"
SMTP_PASS="your-16-character-google-app-password"

# ------------------------------------------------------------------------------
# 4. EXTERNAL INTEGRATIONS & AI SERVICES (Optional)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API Key used by the Auto-Scraper for project title enrichment and AI extraction.
# Obtain from: Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere123456789"

# TELEGRAM_BOT_TOKEN: Telegram Bot API Token for dispatching real-time community/moderation alerts.
# Obtain from: Telegram @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567"

# DISCORD_WEBHOOK_URL: Discord Incoming Webhook for staff escalation alerts and error telemetry.
# Obtain from: Discord Server Settings > Integrations > Webhooks
# Must start with: https://discord.com/api/webhooks/
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/1234567890/your_webhook_token_here"

# ------------------------------------------------------------------------------
# 5. AUTOMATED GOOGLE DRIVE DATABASE BACKUP (GitHub Actions Secrets)
# ------------------------------------------------------------------------------
# Injected via GitHub Repository Secrets for `.github/workflows/db-backup.yml`.
# GDRIVE_SERVICE_ACCOUNT_JSON: Full raw JSON contents of the Google Cloud Service Account key file.
# Must include `client_email` and `private_key`. Can also be provided as Base64-encoded string.
GDRIVE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-gcp-project","private_key_id":"your-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n","client_email":"backup-service@your-gcp-project.iam.gserviceaccount.com"}'

# GDRIVE_FOLDER_ID: Alphanumeric ID of the destination folder created in `joelrjtirma@gmail.com` Google Drive.
# Extracted from folder URL: `https://drive.google.com/drive/folders/<GDRIVE_FOLDER_ID>`
GDRIVE_FOLDER_ID="1a2B3c4D5e6F7g8H9i0J_kLmNoPqRsTuV"

